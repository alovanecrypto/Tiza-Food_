# Copia este archivo como .env junto a server.js y completa tu clave localmente.
# No publiques ni envíes .env. Reinicia el servidor después de cambiarlo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tickets de compra. Usa una clave de Resend y un remitente de un dominio verificado.
RESEND_API_KEY=
TIZA_RECEIPT_FROM=
